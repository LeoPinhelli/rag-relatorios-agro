LLM_PROVIDER=gemini
GEMINI_API_KEY=sua-chave-aqui
LLM_MODEL=gemini-3.5-flash-lite
# Para Anthropic, use LLM_PROVIDER=anthropic e configure ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=.chroma
COLLECTION_NAME=relatorios_agro
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
CLEANING_ENABLED=false
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ALLOWED_DOMAINS=gov.br,usda.gov,nal.usda.gov,argentina.gob.ar,magyp.gob.ar,ibge.gov.br
